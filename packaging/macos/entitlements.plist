<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime lets the app do (S9.4.2), signed into it by build-app.sh.
     Everything else stays refused: no JIT, no unsigned code, no libraries from other teams. -->
<plist version="1.0">
<dict>
  <!-- Open Capture Device (S8.9.2): the hardened runtime blocks cameras and capture cards
       without this, before macOS even asks (NSCameraUsageDescription in Info.plist.ext). -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>

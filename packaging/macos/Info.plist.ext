<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by packaging/macos/build-app.sh (S9.4.2).
     Keep the lists in sync with src/app/file_types.rs; its tests check them. -->
<plist version="1.0">
<dict>
  <!-- Open Capture Device (S8.9.2): macOS stops an app that opens the camera without saying why. -->
  <key>NSCameraUsageDescription</key>
  <string>VLC plays what your camera or capture card shows when you open it with Open Capture Device.</string>
  <!-- Casting (S8.11): macOS blocks browsing the local network for services the app doesn't name,
       and asks the user first, showing this reason. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>VLC looks for Chromecasts and other cast devices on your network so you can play on them.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_googlecast._tcp</string>
  </array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Media file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>3gp</string>
				<string>avi</string>
				<string>flv</string>
				<string>m2ts</string>
				<string>m4v</string>
				<string>mkv</string>
				<string>mov</string>
				<string>mp4</string>
				<string>mpeg</string>
				<string>mpg</string>
				<string>mts</string>
				<string>ogv</string>
				<string>ts</string>
				<string>vob</string>
				<string>webm</string>
				<string>wmv</string>
				<string>aac</string>
				<string>aiff</string>
				<string>ape</string>
				<string>flac</string>
				<string>m4a</string>
				<string>mka</string>
				<string>mp3</string>
				<string>oga</string>
				<string>ogg</string>
				<string>opus</string>
				<string>wav</string>
				<string>wma</string>
				<string>m3u</string>
				<string>m3u8</string>
				<string>pls</string>
				<string>xspf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Streaming URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mms</string>
				<string>rtmp</string>
				<string>rtsp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

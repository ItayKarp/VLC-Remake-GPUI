# Settings for the Jenkins → Discord notifier. Copy to /etc/jenkins-discord-notifier.env and
# make it readable by root only: it holds a Jenkins API token and the Discord webhook URL.

# The local Jenkins, and a user with an API token (Jenkins: your name > Security > API Token).
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_TOKEN=
# The job to follow: the multibranch pipeline's name.
JENKINS_JOB=RedesignedVLC

# A webhook made on the forum channel (Edit Channel > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=
# The post every build goes into. Leave DISCORD_THREAD_ID empty to have the notifier create a
# post with this title on its first build; set it to use a post that already exists (Discord
# developer mode: right-click the post > Copy Thread ID).
DISCORD_POST_TITLE=RedesignedVLC
DISCORD_THREAD_ID=

# How often to ask Jenkins, in seconds, and how many log lines to show while a stage runs.
POLL_SECONDS=5
LOG_LINES=15
